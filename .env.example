# Copy this file to .env.local and fill in your Supabase project's values
# (Project Settings -> API in the Supabase dashboard).
#
# Both are safe to expose in client-side code — the anon key only grants
# access allowed by the Row Level Security policies in supabase/schema.sql.
# Never put the "service_role" key here or anywhere in the frontend.
#
# Leave these unset to run ClearPath in local-only mode (no accounts, no sync).

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
